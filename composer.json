{
    "name": "progineousgb/redirect-allow",
    "description": "Allowlist the host of a Laravel redirect target and fall back when it is not allowed.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "redirect",
        "allowlist"
    ],
    "authors": [
        {
            "name": "Pro Gineous",
            "email": "dev@progineous.com"
        }
    ],
    "require": {
        "php": ">=8.3",
        "league/uri-polyfill": "^7.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "suggest": {
        "illuminate/support": "Optional. Registers the service provider, facade, validation rule, and redirect response on Laravel 12 and 13 (^12.0 || ^13.0). The decision engine does not need Laravel."
    },
    "autoload": {
        "psr-4": {
            "Progineous\\RedirectAllow\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Progineous\\RedirectAllow\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Progineous\\RedirectAllow\\RedirectAllowServiceProvider"
            ],
            "aliases": {
                "RedirectAllow": "Progineous\\RedirectAllow\\Facades\\RedirectAllow"
            }
        }
    },
    "minimum-stability": "stable",
    "scripts": {
        "test": "phpunit"
    }
}
